# Conexión a PostgreSQL (estas credenciales son las del docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/suscripciones_db

# Clave para firmar los JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_por_una_generada_localmente

# Configuración de los tokens de acceso
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para el frontend, separados por coma (Vite usa 5173 por defecto)
CORS_ORIGINS=http://localhost:5173
